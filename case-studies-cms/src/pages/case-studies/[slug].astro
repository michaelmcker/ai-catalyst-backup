---
import {getEmDashEntry} from "emdash";
import {PortableText} from "emdash/ui";
import Base from "../../layouts/Base.astro";
const {entry:study,cacheHint}=await getEmDashEntry("case_studies",Astro.params.slug!);
if(!study)return Astro.redirect('/case-studies/',302);
if(Astro.cache?.enabled)Astro.cache.set(cacheHint);
const d=study.data;
let videoId:string|undefined;
try{const u=new URL(d.video_url||"");if(u.hostname==='youtu.be')videoId=u.pathname.slice(1);else if(['www.youtube.com','youtube.com'].includes(u.hostname))videoId=u.searchParams.get('v')||undefined;}catch{}
if(videoId&&!/^[\w-]{11}$/.test(videoId))videoId=undefined;
---
<Base title={d.title} description={d.summary} content={{collection:'case_studies',id:d.id,slug:study.id}}><a class="back-link" href="/case-studies/">All case studies</a><h1 {...study.edit.title}>{d.title}</h1><p class="study-intro" {...study.edit.summary}>{d.summary}</p>{videoId?<figure class="service-film study-film"><a class="service-film__play" href={`https://youtu.be/${videoId}`} data-youtube-id={videoId} data-video-title={d.title} aria-label={`Play the ${d.client} case study`}><img src={d.poster_url} alt={d.poster_alt||""} width="1280" height="720" loading="lazy" decoding="async"/><span class="service-film__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 3 22 12 7 21Z"/></svg></span>{d.video_duration&&<span class="service-film__duration" aria-hidden="true">{d.video_duration}</span>}</a></figure>:<div class="study-film"><img src={d.poster_url} alt={d.poster_alt||""} width="1280" height="720" loading="lazy" decoding="async"/></div>}<div class="study-body" {...study.edit.content}><PortableText value={d.content||[]}/></div><div class="study-next"><a class="study-link" href="/briefing.html">Talk about your business <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 16 16 4M7 4h9v9"/></svg></a></div></Base>
