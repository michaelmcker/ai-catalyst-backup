---
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/library.css";
interface Props { title: string; description?: string; content?: {collection: string; id: string; slug?: string | null}; }
const {title,description,content}=Astro.props;
const page=createPublicPageContext({Astro,kind:content?"content":"custom",pageType:"website",title:`${title} | AI Catalyst`,pageTitle:title,description,canonical:`https://aicatalyst.biz${Astro.url.pathname}`,content,siteName:"AI Catalyst"});
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | AI Catalyst</title><EmDashHead page={page}/><link rel="stylesheet" href="/site-system.css?v=20261003-audit1"/><link rel="stylesheet" href="/editorial-system.css?v=20260919-14"/><link rel="stylesheet" href="/simplified-navigation.css?v=20261002"/><link rel="stylesheet" href="/client-layout-v3.css?v=20261003-audit1"/><link rel="stylesheet" href="/feedback-v3.css?v=20261023-direct8"/><link rel="stylesheet" href="/migration-changes.css?v=20261023-direct8"/><link rel="stylesheet" href="/service-films.css?v=20261027-film2"/></head><body><EmDashBodyStart page={page}/><a class="skip" href="#main">Skip to content</a><Header/><main class="library wrap" id="main"><slot/></main><Footer/><EmDashBodyEnd page={page}/><script is:inline src="/site-shell.js?v=20261023-direct8" defer></script><script is:inline src="/service-films.js?v=20261027-film1" defer></script></body></html>
